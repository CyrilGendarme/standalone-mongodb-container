# MongoDB root account (required by the official image)
MONGO_INITDB_ROOT_USERNAME=youradmin
MONGO_INITDB_ROOT_PASSWORD=change-me
MONGO_HOST=127.0.0.1
MONGO_PORT=27017

# Per-database users; number suffixes must match
DB_NAME_1=analytics_db
DB_USER_1=analytics_user
DB_PASS_1=change-me-too

DB_NAME_2=users_db
DB_USER_2=users_user
DB_PASS_2=another-change-me

# For truncate_db_collections.sh; comma-separated collection names to keep
TARGET_DB=analytics_db
WHITELIST_COLLECTIONS=users,roles,important_config
